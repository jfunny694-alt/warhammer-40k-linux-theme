conky.config = {
    background = true,
    own_window = true,
    own_window_type = 'desktop',
    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_argb_value = 0,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_colour = '000000',
    
    double_buffer = true,
    override_utf8_locale = true,
    use_xft = true,
    font = 'Inquisitor:size=12',
    xftalpha = 1.0,
    update_interval = 0.5,
    uppercase = false,
    
    draw_borders = false,
    draw_graph_borders = true,
    draw_outline = false,
    draw_shades = false,
    
    alignment = 'top_right',
    gap_x = 30,
    gap_y = 80,
    
    minimum_width = 300,
    maximum_width = 300,
    
    color0 = 'FF2222', -- Mechanicus Red
    color1 = 'FF9800', 
    color2 = 'FFEB3B', 
    color3 = 'FFFFFF', 
};

conky.text = [[
${alignr}${color0}++ SHIP SYSTEMS ++
${alignr}- COGITATOR MAINFRAME -
${alignr}======================================
Host${alignr}${nodename}
Kernel${alignr}${exec uname -r | cut -c 1-15}
Uptime${alignr}${uptime}

${alignr}- PLASMA CORE STATUS -
Design: ${alignr}Intel Core i3-8100
Frequency${alignr}${freq_g} GHz
Temperature${alignr}${hwmon temp 1}°C

Total Load ${alignr}${cpu cpu0}%
${color0}${cpubar cpu0 10,200}

Core 1: ${cpu cpu1}% ${alignr}${cpubar cpu1 8,100}
Core 2: ${cpu cpu2}% ${alignr}${cpubar cpu2 8,100}
Core 3: ${cpu cpu3}% ${alignr}${cpubar cpu3 8,100}
Core 4: ${cpu cpu4}% ${alignr}${cpubar cpu4 8,100}

${alignr}- COGITATOR MEMORY BANKS -
RAM${alignr}${mem} / ${memmax}
${membar 10}

${alignr}- TOP COGITATOR ALLOCATION -
> ${top_mem name 1}${alignr}${top_mem mem_res 1}
> ${top_mem name 2}${alignr}${top_mem mem_res 2}
> ${top_mem name 3}${alignr}${top_mem mem_res 3}
> ${top_mem name 4}${alignr}${top_mem mem_res 4}

${alignr}- INFORMATION STORAGE -
${alignr}======================================
Root${alignr}${fs_used /} / ${fs_size /}
${fs_bar 10 /}
]];
